<!--
  Add these lines inside the generated android/app/src/main/AndroidManifest.xml
  See README.md step 4 for exactly where each block goes.
-->

<!-- 1. Add these permissions as siblings of the existing <uses-permission> tags,
        just above the <application> tag -->
<uses-permission android:name="android.permission.CAMERA"/>
<uses-permission android:name="android.permission.RECORD_AUDIO"/>
<uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION"/>
<uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
<uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
<!-- Lets the floating screenshot button draw on top of other apps. Android makes the user
     grant this manually in Settings — the app cannot request it with a normal runtime-permission
     popup, which is why enableFloatingCapture() sends the person to that settings screen the
     first time. -->
<uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
<!-- Only actually used on Android 9 and below (maxSdkVersion caps it there) — Android 10+ saves
     files through scoped storage (MediaStore) instead, which needs no storage permission at all. -->
<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28"/>

<!-- 2. Add this <uses-feature> tag alongside the permissions above, so the Play Store
        doesn't hide the app from devices without a camera (optional="true" keeps it
        installable on camera-less devices too, e.g. some tablets) -->
<uses-feature android:name="android.hardware.camera" android:required="false"/>

<!-- 3. Add these <service> tags INSIDE <application>...</application>, as siblings of
        the existing <activity android:name=".MainActivity"> tag -->
<service
    android:name=".ScreenCaptureService"
    android:foregroundServiceType="mediaProjection"
    android:exported="false" />
<service
    android:name=".FloatingButtonService"
    android:foregroundServiceType="specialUse"
    android:exported="false">
    <property
        android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
        android:value="floating-screenshot-button" />
</service>
